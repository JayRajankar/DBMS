## 2. Comprehensive Aggregation Operations

### Basic Aggregations

```javascript
// 1. Group by Department and Calculate Average Salary
db.Employee.aggregate([
    {
        $group: {
            _id: "$emp_dept",
            avgSalary: { $avg: "$salary" },
            employeeCount: { $sum: 1 }
        }
    }
]);

// 2. Filter Employees with Salary > 55000
db.Employee.aggregate([
    {
        $match: { salary: { $gt: 55000 } }
    },
    {
        $project: {
            emp_name: 1,
            emp_dept: 1,
            salary: 1,
            formattedSalary: { $concat: ["$", { $toString: { $divide: ["$salary", 1000] } }, "K"] }
        }
    }
]);

// 3. Sort Employees by Salary in Descending Order
db.Employee.aggregate([
    {
        $sort: { salary: -1 }
    },
    {
        $limit: 5
    }
]);

// 4. Calculate Total Salary for Each Department
db.Employee.aggregate([
    {
        $group: {
            _id: "$emp_dept",
            totalSalary: { $sum: "$salary" },
            employees: { $push: "$emp_name" }
        }
    }
]);
```

### Advanced Aggregations

```javascript
// 5. Department-wise salary statistics (min, max, avg)
db.Employee.aggregate([
    {
        $group: {
            _id: "$emp_dept",
            minSalary: { $min: "$salary" },
            maxSalary: { $max: "$salary" },
            avgSalary: { $avg: "$salary" },
            totalEmployees: { $sum: 1 }
        }
    },
    {
        $sort: { avgSalary: -1 }
    }
]);

// 6. Employees with specific skills (using $unwind and $match)
db.Employee.aggregate([
    {
        $unwind: "$skills"
    },
    {
        $match: { skills: { $in: ["mongodb", "nodejs"] } }
    },
    {
        $group: {
            _id: "$emp_id",
            emp_name: { $first: "$emp_name" },
            skills: { $push: "$skills" }
        }
    }
]);

// 7. Employees by tenure (years of service)
db.Employee.aggregate([
    {
        $project: {
            emp_name: 1,
            emp_dept: 1,
            yearsOfService: {
                $floor: {
                    $divide: [
                        { $subtract: [new Date(), "$join_date"] },
                        365 * 24 * 60 * 60 * 1000
                    ]
                }
            }
        }
    },
    {
        $sort: { yearsOfService: -1 }
    }
]);

// 8. Salary distribution by department (using $bucket)
db.Employee.aggregate([
    {
        $bucket: {
            groupBy: "$salary",
            boundaries: [50000, 60000, 70000, 80000],
            default: "Other",
            output: {
                count: { $sum: 1 },
                employees: { $push: "$emp_name" },
                departments: { $addToSet: "$emp_dept" }
            }
        }
    }
]);
```

## 3. Comprehensive Indexing Implementation

### Creating Different Types of Indexes

```javascript
// 1. Single Field Index
db.Employee.createIndex({ emp_id: 1 }, { unique: true }); // Unique identifier
db.Employee.createIndex({ emp_dept: 1 }); // Department queries
db.Employee.createIndex({ salary: -1 }); // Descending salary

// 2. Compound Index
db.Employee.createIndex({ emp_dept: 1, salary: -1 }); // Department with salary sorting

// 3. Multikey Index (for array fields)
db.Employee.createIndex({ skills: 1 }); // Index on array elements

// 4. Text Index (for text search)
db.Employee.createIndex({ emp_name: "text" });

// 5. TTL Index (for automatic expiration)
db.Employee.createIndex({ join_date: 1 }, { expireAfterSeconds: 3600 }); // Example - would need proper field

// 6. Sparse Index (only index documents with the field)
db.Employee.createIndex({ "bonus": 1 }, { sparse: true });

// 7. Partial Index (index only documents matching filter)
db.Employee.createIndex(
    { salary: 1 },
    { partialFilterExpression: { salary: { $gt: 60000 } } }
);
```

### Index Utilization and Management

```javascript
// View all indexes
db.Employee.getIndexes();

// Query using indexes with explain
// 1. Using single field index
db.Employee.find({ emp_dept: "IT" }).explain("executionStats");

// 2. Using compound index
db.Employee.find({ 
    emp_dept: "IT", 
    salary: { $gt: 55000 } 
}).sort({ salary: -1 }).explain("executionStats");

// 3. Using text index
db.Employee.find({ $text: { $search: "John Alice" } }).explain("executionStats");

// 4. Using multikey index
db.Employee.find({ skills: "mongodb" }).explain("executionStats");

// Drop indexes
db.Employee.dropIndex("emp_dept_1"); // Drop by index name
db.Employee.dropIndex({ "emp_dept": 1, "salary": -1 }); // Drop by specification

// Index size and usage stats
db.Employee.aggregate([{ $indexStats: {} }]);
```

## 4. Complete Example with Aggregation Pipeline Using Indexes

```javascript
// Complex aggregation using indexes
db.Employee.aggregate([
    {
        $match: {
            emp_dept: { $in: ["IT", "Finance"] },
            salary: { $gt: 55000 }
        }
    },
    {
        $lookup: {
            from: "departments", // hypothetical collection
            localField: "emp_dept",
            foreignField: "dept_name",
            as: "dept_info"
        }
    },
    {
        $unwind: "$dept_info"
    },
    {
        $project: {
            emp_name: 1,
            department: "$emp_dept",
            salary: 1,
            dept_budget: "$dept_info.budget",
            salary_ratio: {
                $divide: ["$salary", "$dept_info.budget"]
            }
        }
    },
    {
        $sort: { salary_ratio: -1 }
    },
    {
        $limit: 3
    }
], { allowDiskUse: true });
```

