CREATE VIEW IssuedBooks AS
SELECT Rollin, Name, NameofBook, DateofIssue
FROM Borrower
WHERE Status = 'I';

CREATE INDEX idx_rollin_book
ON Borrower (Rollin, NameofBook);

CREATE VIEW LibraryUsers AS
SELECT * FROM Borrower;

