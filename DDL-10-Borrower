CREATE TABLE Borrower (
    ID INT AUTO_INCREMENT PRIMARY KEY,
    Rollin INT NOT NULL,
    Name VARCHAR(100),
    DateofIssue DATE,
    NameofBook VARCHAR(100),
    Status CHAR(1)  -- 'I' for Issued, 'R' for Returned
);

