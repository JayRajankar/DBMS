-- 1. Table Creation

CREATE TABLE Customer (
    CustomerId INT PRIMARY KEY,
    CustomerName VARCHAR(50) NOT NULL,
    Phone VARCHAR(15) UNIQUE,
    Email VARCHAR(50) UNIQUE,
    Address VARCHAR(100) NOT NULL
);

CREATE TABLE Branch (
    BranchId INT PRIMARY KEY,
    BranchName VARCHAR(50) NOT NULL,
    BranchAddress VARCHAR(100) NOT NULL
);

CREATE TABLE Account (
    AcctNo INT PRIMARY KEY,
    CustomerId INT,
    BranchId INT,
    Balance DECIMAL(10,2) NOT NULL,
    AcctType VARCHAR(20) NOT NULL,
    FOREIGN KEY (CustomerId) REFERENCES Customer(CustomerId),
    FOREIGN KEY (BranchId) REFERENCES Branch(BranchId)
);

CREATE TABLE Loan (
    LoanId INT PRIMARY KEY,
    CustomerId INT,
    LoanAmount DECIMAL(10,2) NOT NULL,
    LoanType VARCHAR(20) NOT NULL,
    FOREIGN KEY (CustomerId) REFERENCES Customer(CustomerId)
);

CREATE TABLE BankTransaction (
    TransId INT PRIMARY KEY,
    AcctNo INT,
    TransDate DATE NOT NULL,
    TransAmount DECIMAL(10,2) NOT NULL,
    TransType VARCHAR(20) NOT NULL,
    FOREIGN KEY (AcctNo) REFERENCES Account(AcctNo)
);

-- 2. Views

CREATE VIEW CustomerAccountView AS
SELECT c.CustomerId, c.CustomerName, a.AcctNo, a.Balance, a.AcctType
FROM Customer c
JOIN Account a ON c.CustomerId = a.CustomerId;

CREATE VIEW LoanCustomerView AS
SELECT l.LoanId, l.LoanAmount, l.LoanType, c.CustomerName, c.Phone
FROM Loan l
JOIN Customer c ON l.CustomerId = c.CustomerId;

-- 3. Index

CREATE INDEX CustomerId_Index
ON Customer (CustomerName ASC);

