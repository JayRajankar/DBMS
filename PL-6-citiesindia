DELIMITER $$

CREATE PROCEDURE CalculatePopulationDensity()
BEGIN
    DECLARE done INT DEFAULT 0;
    DECLARE v_pincode INT;
    DECLARE v_population INT;
    DECLARE v_area DECIMAL(10,2);
    DECLARE v_density DECIMAL(10,4);
    DECLARE v_type VARCHAR(20);

    -- Cursor to iterate through CitiesIndia
    DECLARE city_cursor CURSOR FOR
    SELECT pincode, population, area
    FROM CitiesIndia;

    -- Handle NOT FOUND condition
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = 1;

    OPEN city_cursor;

    city_loop: LOOP
        FETCH city_cursor INTO v_pincode, v_population, v_area;
        IF done = 1 THEN
            LEAVE city_loop;
        END IF;

        -- Error handling for invalid population
        IF v_population <= 0 THEN
            SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Invalid population value';
        END IF;

        -- Calculate population density
        SET v_density = v_population / v_area;

        -- Determine city type based on density
        IF v_density > 3000 THEN
            SET v_type = 'High Density';
        ELSEIF v_density BETWEEN 1000 AND 2999 THEN
            SET v_type = 'Moderate Density';
        ELSE
            SET v_type = 'Low Density';
        END IF;

        -- Insert or update the Categories table
        INSERT INTO Categories (Type, pincode)
        VALUES (v_type, v_pincode)
        ON DUPLICATE KEY UPDATE Type = v_type;
    END LOOP;

    CLOSE city_cursor;
END$$

DELIMITER ;

CALL CalculatePopulationDensity();

