-- Step 1: Create Tables
CREATE TABLE borrower (
    rollin INT PRIMARY KEY,
    name VARCHAR(50),
    dateofissue DATE,
    nameofbook VARCHAR(100),
    status CHAR(1)
);

CREATE TABLE fine (
    roll_no INT,
    date DATE,
    amt INT,
    FOREIGN KEY (roll_no) REFERENCES borrower(rollin)
);

