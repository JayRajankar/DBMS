### 🧱 Step 1: Create Tables

```sql
-- Borrower Table
CREATE TABLE Borrower (
    Rollin        NUMBER PRIMARY KEY,
    Name          VARCHAR2(50),
    DateofIssue   DATE,
    NameofBook    VARCHAR2(100),
    Status        CHAR(1) -- 'I' for Issued, 'R' for Returned
);

-- Fine Table
CREATE TABLE Fine (
    Roll_no   NUMBER,
    Date      DATE,
    Amt       NUMBER,
    FOREIGN KEY (Roll_no) REFERENCES Borrower(Rollin)
);
```

