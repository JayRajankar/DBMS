### ✅ Step-by-Step Full Code for MySQL

```sql
-- Step 1: Create the main Library table
CREATE TABLE Library (
    book_id INT PRIMARY KEY,
    title VARCHAR(255),
    author VARCHAR(255),
    genre VARCHAR(100),
    issued_to VARCHAR(100)
);

-- Step 2: Create the audit table to store old records
CREATE TABLE Library_Audit (
    audit_id INT PRIMARY KEY AUTO_INCREMENT,
    action_type VARCHAR(10),     -- 'UPDATE' or 'DELETE'
    book_id INT,
    title VARCHAR(255),
    author VARCHAR(255),
    genre VARCHAR(100),
    issued_to VARCHAR(100),
    action_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Step 3: Create the trigger for UPDATE operations
DELIMITER $$

CREATE TRIGGER after_library_update
AFTER UPDATE ON Library
FOR EACH ROW
BEGIN
    INSERT INTO Library_Audit (action_type, book_id, title, author, genre, issued_to)
    VALUES ('UPDATE', OLD.book_id, OLD.title, OLD.author, OLD.genre, OLD.issued_to);
END$$

DELIMITER ;

-- Step 4: Create the trigger for DELETE operations
DELIMITER $$

CREATE TRIGGER after_library_delete
AFTER DELETE ON Library
FOR EACH ROW
BEGIN
    INSERT INTO Library_Audit (action_type, book_id, title, author, genre, issued_to)
    VALUES ('DELETE', OLD.book_id, OLD.title, OLD.author, OLD.genre, OLD.issued_to);
END$$

DELIMITER ;
```

