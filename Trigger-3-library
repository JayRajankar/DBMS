### ✅ `AFTER INSERT` Trigger on `Library`

```sql
DELIMITER $$

CREATE TRIGGER UpdateNocTrigger_Insert
AFTER INSERT ON Library
FOR EACH ROW
BEGIN
    DECLARE current_noc INT;

    SELECT COALESCE(noc, 0)
    INTO current_noc
    FROM Library_Audit
    WHERE bid = NEW.bid
    LIMIT 1;

    IF NEW.status = 'RETURN' THEN
        SET current_noc = current_noc + 1;
    ELSEIF NEW.status = 'ISSUE' THEN
        SET current_noc = current_noc - 1;
    END IF;

    DELETE FROM Library_Audit WHERE bid = NEW.bid;

    INSERT INTO Library_Audit (bid, bname, noc, timestampofquery, action)
    VALUES (NEW.bid, NEW.bname, current_noc, NOW(), NEW.status);
END$$

DELIMITER ;
```

