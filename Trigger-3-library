### ✅ `AFTER UPDATE OR DELETE` Trigger on `Library`

```sql
DELIMITER $$

CREATE TRIGGER LibraryAuditTrigger
AFTER UPDATE OR DELETE ON Library
FOR EACH ROW
BEGIN
    IF OLD.bid IS NOT NULL THEN
        INSERT INTO Library_Audit (bid, bname, noc, timestampofquery, action)
        VALUES (
            OLD.bid,
            OLD.bname,
            OLD.noc,
            NOW(),
            CASE 
                WHEN OLD.bid = NEW.bid THEN 'UPDATE'
                ELSE 'DELETE'
            END
        );
    END IF;
END$$

DELIMITER ;
