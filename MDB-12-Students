# MongoDB Indexing and Querying Implementation

Here's a complete implementation of indexing and querying with MongoDB for the Students collection, including the MapReduce example and a similar aggregation in MongoDB to match the PL/SQL functionality:

## 1. Setting up the Collection with Indexes

```javascript
// Create Students collection with sample data
db.Students.insertMany([
    { 
        stud_id: 101, 
        stud_name: "John Doe", 
        stud_addr: "New York", 
        stud_marks: [85, 90, 78, 92] 
    },
    { 
        stud_id: 102, 
        stud_name: "Jane Smith", 
        stud_addr: "Los Angeles", 
        stud_marks: [75, 88, 92, 81] 
    },
    { 
        stud_id: 103, 
        stud_name: "Mike Johnson", 
        stud_addr: "New York", 
        stud_marks: [90, 85, 88, 94] 
    },
    { 
        stud_id: 104, 
        stud_name: "Sarah Williams", 
        stud_addr: "Chicago", 
        stud_marks: [82, 79, 91, 87] 
    }
]);

// Create indexes for better performance
db.Students.createIndex({ stud_id: 1 });        // Unique identifier
db.Students.createIndex({ stud_addr: 1 });      // For address-based queries
db.Students.createIndex({ "stud_marks": 1 });   // For marks-based queries
```

## 2. MapReduce Example: Calculate Average Marks by City

```javascript
// Map function - emits city and marks array
var mapFunction = function() {
    this.stud_marks.forEach(function(mark) {
        emit(this.stud_addr, mark);
    });
};

// Reduce function - calculates average
var reduceFunction = function(key, values) {
    return Array.avg(values);
};

// Perform MapReduce
db.Students.mapReduce(
    mapFunction,
    reduceFunction,
    {
        out: "avg_marks_by_city",
        query: {} // optional filter if needed
    }
);

// Query the result
db.avg_marks_by_city.find().pretty();
```

## 3. Alternative to PL/SQL: Calculating Total and Percentage using Aggregation

```javascript
// MongoDB equivalent of the PL/SQL code to calculate total and percentage
var calculateStudentStats = function(studentId) {
    try {
        var result = db.Students.aggregate([
            {
                $match: { stud_id: studentId }
            },
            {
                $project: {
                    stud_id: 1,
                    stud_name: 1,
                    total_marks: { $sum: "$stud_marks" },
                    percentage: { $avg: "$stud_marks" }
                }
            }
        ]).toArray();
        
        if (result.length === 0) {
            print("Student not found");
        } else {
            var student = result[0];
            print("Student ID: " + student.stud_id);
            print("Student Name: " + student.stud_name);
            print("Total Marks: " + student.total_marks);
            print("Percentage: " + student.percentage.toFixed(2) + "%");
        }
    } catch (e) {
        print("Error occurred: " + e.message);
    }
};

// Usage example
calculateStudentStats(101);
```

## 4. Additional Query Examples

```javascript
// Find students with average marks above 85
db.Students.aggregate([
    {
        $project: {
            stud_id: 1,
            stud_name: 1,
            stud_addr: 1,
            avg_marks: { $avg: "$stud_marks" }
        }
    },
    {
        $match: { avg_marks: { $gt: 85 } }
    }
]);

// Find top performing students by city
db.Students.aggregate([
    {
        $group: {
            _id: "$stud_addr",
            topStudent: { 
                $max: { 
                    avgMarks: { $avg: "$stud_marks" },
                    name: "$stud_name",
                    id: "$stud_id"
                } 
            }
        }
    },
    {
        $project: {
            city: "$_id",
            studentName: "$topStudent.name",
            studentId: "$topStudent.id",
            averageMarks: "$topStudent.avgMarks",
            _id: 0
        }
    }
]);
```

## 5. Index Utilization Examples

```javascript
// Example query that will use the stud_id index
db.Students.find({ stud_id: 101 }).explain("executionStats");

// Example query that will use the stud_addr index
db.Students.find({ stud_addr: "New York" }).explain("executionStats");

// Example query that will use the stud_marks index (for range queries)
db.Students.find({ "stud_marks": { $gt: 90 } }).explain("executionStats");
```

