DELIMITER $$

CREATE PROCEDURE merge_rollcall()
BEGIN
  DECLARE done INT DEFAULT FALSE;
  DECLARE v_roll_no INT;
  DECLARE v_name VARCHAR(100);
  DECLARE v_course VARCHAR(100);
  
  DECLARE cur CURSOR FOR SELECT ROLL_NO, NAME, COURSE FROM N_RollCall;
  DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;

  OPEN cur;
  
  read_loop: LOOP
    FETCH cur INTO v_roll_no, v_name, v_course;
    IF done THEN
      LEAVE read_loop;
    END IF;

    -- Check if record exists
    IF NOT EXISTS (
      SELECT 1 FROM O_RollCall 
      WHERE ROLL_NO = v_roll_no AND NAME = v_name AND COURSE = v_course
    ) THEN
      INSERT INTO O_RollCall (ROLL_NO, NAME, COURSE)
      VALUES (v_roll_no, v_name, v_course);
    END IF;
    
  END LOOP;

  CLOSE cur;
END$$

DELIMITER ;

-- To call the procedure:
CALL merge_rollcall();
